NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: required for a self-hosted HTTPS endpoint. Leave unset on managed Supabase.
SUPABASE_SELF_HOSTED_ORIGIN=
# Preserve the original 20-letter project identity when migrating existing archives.
MONITORING_SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
FIRST_ADMIN_USER_ID=
# Server-only canonical HTTPS origin for production writes (for example, https://app.example.com).
APP_ORIGIN=

# Monitoring server only. Generate a random token of at least 32 characters.
# The local worker uses only MONITORING_INGEST_TOKEN, never the database secret.
MONITORING_INGEST_TOKEN=
MONITORING_INGEST_SOURCE_IDS=ponto-legado-cd-jk,ponto-iso-cd-jk,defense-access-cd-jk,defense-person-cd-jk
MONITORING_SUPABASE_SERVICE_ROLE_KEY=
