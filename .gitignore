# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/artifacts/
/output/playwright/

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# supabase local state
/supabase/.branches/
/supabase/.temp/

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

# HR source workbooks and reports with personal data (local only)
/data/private/*
!/data/private/.gitkeep

# Local monitoring sources, photographs and worker state (personal data)
/ACESSOS DEFENSE/
/relogio de ponto/
/.monitoring-worker/
/monitoramento.local.json

# Imported operational context must stay local in every checkout.
/contexto-importado/
/.importacao-administrativo-cd-rh/
/AFD*.txt
